import java.util.*;

class Solution {

    public void deleteMid(Stack<Integer> s) {
        int mid = s.size() / 2;
        solve(s, mid);
    }

    void solve(Stack<Integer> s, int k) {

        if (k == 0) {
            s.pop();
            return;
        }

        int temp = s.pop();

        solve(s, k - 1);

        s.push(temp);
    }
}
